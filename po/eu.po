#: panel-plugin/devices.c:288 panel-plugin/devices.c:311
#: panel-plugin/devices.c:374 panel-plugin/devices.c:385
#: panel-plugin/devices.c:395 panel-plugin/devices.c:481
msgid "Xfce 4 Mount Plugin"
msgstr "Xfce 4 muntatze-plugina"

#: panel-plugin/devices.c:290
msgid "Failed to mount device:"
msgstr "Ezin izan da gailua muntatu:"

#: panel-plugin/devices.c:313
msgid "Error executing on-mount command:"
msgstr "Errorea muntatu ondorengo komandoa exekutatzean:"

#: panel-plugin/devices.c:376
msgid "Failed to umount device:"
msgstr "Ezin izan da gailua desmuntatu:"

#: panel-plugin/devices.c:387
msgid "The device should be removable safely now:"
msgstr "Orain gailua segurtasunez kendu daiteke:"

#: panel-plugin/devices.c:397
msgid "An error occurred. The device should not be removed:"
msgstr "Errore bat gertatu da. Ez kendu gailua:"

#: panel-plugin/devices.c:483
msgid ""
"Your /etc/fstab could not be read. This will severely degrade the plugin's "
"abilities."
msgstr "Ezin izan da /etc/fstab fitxategia irakurri. Horrek pluginaren gaitasunak asko murriztuko ditu."

#: panel-plugin/mount-plugin.c:204
msgid " -> "
msgstr " -> "

#: panel-plugin/mount-plugin.c:262
#, c-format
msgid "[%s/%s] %s free"
msgstr "[%s/%s] %s libre"

#: panel-plugin/mount-plugin.c:285
msgid "<span foreground=\"#FF0000\">not mounted</span>"
msgstr "<span foreground=\"#FF0000\">muntatu gabe</span>"

#: panel-plugin/mount-plugin.c:360
msgid ""
"<b><i><span font_size=\"large\">Xfce 4 Mount Plugin – Devices and Mount "
"Points</span></i></b>"
msgstr "<b><i><span font_size=\"large\">Xfce 4 muntatze-plugina – Gailuak eta muntatze-puntuak</span></i></b>"

#: panel-plugin/mount-plugin.c:579
msgid "devices"
msgstr "gailuak"

#: panel-plugin/mount-plugin.c:769
msgid "Mount Plugin"
msgstr "Muntatze-plugina"

#: panel-plugin/mount-plugin.c:772
msgid "_Close"
msgstr "_Itxi"

#: panel-plugin/mount-plugin.c:775
msgid "Properties"
msgstr "Propietateak"

#: panel-plugin/mount-plugin.c:806
msgid ""
"This is only useful and recommended if you specify \"sync\" as part of the "
"\"unmount\" command string."
msgstr "Hau \"unmount\" komandoaren katean \"sync\" zehazten baduzu soilik da erabilgarria eta gomendagarria."

#: panel-plugin/mount-plugin.c:810
msgid "Show _message after unmount"
msgstr "Erakutsi _mezua desmuntatu ondoren"

#: panel-plugin/mount-plugin.c:822
msgid "You can specify a distinct icon to be displayed in the panel."
msgstr "Panelean bistaratzeko beste ikono bat zehaztu dezakezu."

#: panel-plugin/mount-plugin.c:828
msgid "Icon:"
msgstr "Ikonoa:"

#: panel-plugin/mount-plugin.c:832
msgid "Select an image"
msgstr "Hautatu irudi bat"

#: panel-plugin/mount-plugin.c:839
msgid "_General"
msgstr "_Orokorra"

#: panel-plugin/mount-plugin.c:854
#, c-format
msgid ""
"This command will be executed after mounting the device with the mount point of the device as argument.\n"
"If you are unsure what to insert, try \"%s %%m\".\n"
"'%%d' can be used to specify the device, '%%m' for the mountpoint."
msgstr "Komando hau gailua muntatu ondoren exekutatuko da, gailuaren muntatze-puntua argumentu gisa hartuta.\nZer idatzi ez badakizu, probatu \"%s %%m\".\n'%%d' erabil daiteke gailua zehazteko, eta '%%m' muntatze-puntua zehazteko."

#: panel-plugin/mount-plugin.c:870
msgid "_Execute after mounting:"
msgstr "_Exekutatu muntatu ondoren:"

#: panel-plugin/mount-plugin.c:893
msgid ""
"WARNING: These options are for experts only! If you do not know what they "
"may be good for, keep your hands off!"
msgstr "ABISUA: aukera hauek adituentzat soilik dira! Zertarako diren ez badakizu, ez ukitu!"

#: panel-plugin/mount-plugin.c:897
msgid "_Custom commands"
msgstr "Komando _pertsonalizatuak"

#: panel-plugin/mount-plugin.c:916
#, c-format
msgid ""
"Most users will only want to prepend \"sudo\" to both commands or prepend \"sync %d &&\" to the \"unmount %d\" command.\n"
"'%d' is used to specify the device, '%m' for the mountpoint."
msgstr "Erabiltzaile gehienek bi komandoen aurretik \"sudo\" jarri, edo \"sync %d &&\" \"unmount %d\" komandoaren aurretik jarri nahiko dute soilik.\n'%d' gailua zehazteko erabiltzen da, eta '%m' muntatze-puntua zehazteko."

#: panel-plugin/mount-plugin.c:924
msgid "_Mount command:"
msgstr "_Muntatze-komandoa:"

#: panel-plugin/mount-plugin.c:929
msgid "_Unmount command:"
msgstr "_Desmuntatze-komandoa:"

#: panel-plugin/mount-plugin.c:954
msgid "_Commands"
msgstr "_Komandoak"

#: panel-plugin/mount-plugin.c:969
msgid ""
"Activate this option to also display network file systems like NFS, SMBFS, "
"SHFS and SSHFS."
msgstr "Gaitu aukera hau NFS, SMBFS, SHFS eta SSHFS bezalako sareko fitxategi-sistemak ere bistaratzeko."

#: panel-plugin/mount-plugin.c:973
msgid "Display _network file systems"
msgstr "Erakutsi _sareko fitxategi-sistemak"

#: panel-plugin/mount-plugin.c:986
msgid ""
"Activate this option to also eject a CD-drive after unmounting and to insert"
" before mounting."
msgstr "Gaitu aukera hau CD-unitatea desmuntatu ondoren egozteko eta muntatu aurretik sartzeko ere."

#: panel-plugin/mount-plugin.c:990
msgid "_Eject CD-drives"
msgstr "_Egotzi CD-unitateak"

#: panel-plugin/mount-plugin.c:1003
msgid "Activate this option to only have the mount points be displayed."
msgstr "Gaitu aukera hau muntatze-puntuak soilik bistaratzeko."

#: panel-plugin/mount-plugin.c:1006
msgid "Display _mount points only"
msgstr "Erakutsi _muntatze-puntuak soilik"

#: panel-plugin/mount-plugin.c:1021
msgid ""
"Trim the device names to the number of characters specified in the spin "
"button."
msgstr "Moztu gailuen izenak biratze-botoian zehaztutako karaktere kopurura."

#: panel-plugin/mount-plugin.c:1027
msgid "Trim device names: "
msgstr "Moztu gailuen izenak: "

#: panel-plugin/mount-plugin.c:1036
msgid " characters"
msgstr " karaktere"

#: panel-plugin/mount-plugin.c:1053
msgid ""
"Exclude the following file systems from the menu.\n"
"The list is separated by simple spaces.\n"
"It is up to you to specify correct devices or mount points.\n"
"An asterisk (*) can be used as a placeholder at the end of\n"
"a path, e.g., \"/mnt/*\" to exclude any mountpoints below \"/mnt\".\n"
msgstr "Baztertu fitxategi-sistema hauek menutik.\nZerrendako elementuak hutsune soilez bereizten dira.\nZure ardura da gailu edo muntatze-puntu zuzenak zehaztea.\nIzartxoa (*) ordezko gisa erabil daiteke bide baten\namaieran, adib. \"/mnt/*\", \"/mnt\" azpiko muntatze-puntu guztiak baztertzeko.\n"

#: panel-plugin/mount-plugin.c:1064
msgid "E_xclude specified file systems"
msgstr "_Baztertu zehaztutako fitxategi-sistemak"

#: panel-plugin/mount-plugin.c:1079
msgid "_File systems"
msgstr "_Fitxategi-sistemak"

#: panel-plugin/mount-plugin.c:1102
msgid "Show partitions/devices and allow to mount/unmount them"
msgstr "Erakutsi partizioak/gailuak eta baimendu haiek muntatzea/desmuntatzea"

#: panel-plugin/xfce4-mount-plugin.desktop.in:5
msgid "Mount devices"
msgstr "Muntatu gailuak"

#: panel-plugin/xfce4-mount-plugin.desktop.in:6
msgid "Shows all mountable devices and (un)mounts them on request."
msgstr "Gailu muntagarri guztiak erakusten ditu eta eskatzean (des)muntatzen ditu."
